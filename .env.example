# Environment Variables — шаблон для локальной разработки
# Скопируйте в .env.dev и при необходимости измените значения:
#   cp .env.example .env.dev
# Используется в docker-compose.dev.yml

# PostgreSQL Configuration
POSTGRES_USER=todouser
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tododb
POSTGRES_PORT=5433

# Backend Configuration
BACKEND_PORT=3000

# Frontend Configuration
FRONTEND_PORT=5173

# Database Connection String (для использования в приложении)
DATABASE_URL=postgresql://todouser:change_me@postgres:5432/tododb?schema=public

# Test Database Configuration (e2e-тесты, изолированный контейнер postgres-test)
POSTGRES_TEST_DB=tododb_test
TEST_DATABASE_URL=postgresql://todouser:change_me@postgres-test:5432/tododb_test?schema=public
